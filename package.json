{
  "name": "whaticon",
  "version": "0.4.0",
  "description": "Find matching Iconify icons by visual similarity",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "whaticon": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./hash": {
      "import": "./dist/hash.js",
      "require": "./dist/hash.js",
      "types": "./dist/hash.d.ts"
    },
    "./match": {
      "import": "./dist/match.js",
      "require": "./dist/match.js",
      "types": "./dist/match.d.ts"
    },
    "./download": {
      "import": "./dist/download.js",
      "require": "./dist/download.js",
      "types": "./dist/download.d.ts"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "indexes:bundle": "bun run scripts/indexes/bundle.ts",
    "indexes:build": "bun run scripts/indexes/build.ts",
    "icon-sets:install": "bun run scripts/icon-sets/install.ts",
    "indexes:release": "bun run scripts/indexes/release.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings --type-aware --type-check src scripts tests",
    "format": "oxfmt src scripts tests",
    "format:check": "oxfmt --check src scripts tests",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "prepublishOnly": "bun run build",
    "version": "bun run scripts/release/version.ts && git add src/version.ts"
  },
  "keywords": [
    "icon",
    "iconify",
    "svg",
    "search",
    "match",
    "reverse",
    "phash",
    "perceptual-hash",
    "visual-similarity"
  ],
  "author": "Danila Poyarkov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-pencil/whaticon.git"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@iconify-json/bi": "latest",
    "@iconify-json/carbon": "latest",
    "@iconify-json/fa6-regular": "latest",
    "@iconify-json/fa6-solid": "latest",
    "@iconify-json/fluent": "latest",
    "@iconify-json/heroicons": "latest",
    "@iconify-json/ion": "latest",
    "@iconify-json/lucide": "latest",
    "@iconify-json/mdi": "latest",
    "@iconify-json/ph": "latest",
    "@iconify-json/ri": "latest",
    "@iconify-json/tabler": "latest",
    "@iconify/utils": "^3.1.7",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20.11.0"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "peerDependencies": {
    "sharp": "^0.35.5"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  }
}
