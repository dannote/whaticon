{
  "name": "whaticon",
  "version": "0.1.3",
  "description": "Find matching Iconify icons by visual similarity",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "whaticon": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./hash": {
      "import": "./dist/hash.js",
      "require": "./dist/hash.js",
      "types": "./dist/hash.d.ts"
    },
    "./download": {
      "import": "./dist/download.js",
      "require": "./dist/download.js",
      "types": "./dist/download.d.ts"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:index": "bun run scripts/build-index.ts",
    "build:all-indexes": "bun run scripts/build-all-indexes.ts",
    "install:icon-sets": "bun run scripts/install-icon-sets.ts",
    "release:indexes": "bun run scripts/release-indexes.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings --type-aware --type-check src scripts tests",
    "format": "oxfmt src scripts tests",
    "format:check": "oxfmt --check src scripts tests",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "icon",
    "iconify",
    "svg",
    "search",
    "match",
    "reverse",
    "phash",
    "perceptual-hash",
    "visual-similarity"
  ],
  "author": "Danila Poyarkov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannote/whaticon.git"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "sharp": "^0.35.5",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/carbon": "^1.2.18",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/fluent": "^1.2.37",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/ion": "^1.2.6",
    "@iconify-json/lucide": "^1.2.86",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/ri": "^1.2.7",
    "@iconify-json/tabler": "^1.2.26",
    "@iconify/utils": "^3.1.7",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20.9.0"
  }
}
